# Database (Neon)
DATABASE_URL=

# Vercel Cron sends this as "Authorization: Bearer <value>". Required for /api/cron/*.
CRON_SECRET=

# Optional source credentials
VULNCHECK_API_TOKEN=
NVD_API_KEY=

# Optional raw payload archive (Cloudflare R2). All four must be set to enable it.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Optional: "Draft with AI" on /admin/events/[id]. Leave blank to disable the button.
ANTHROPIC_API_KEY=
# Model id for AI drafts. Defaults to claude-haiku-5-5 when unset.
STP_DRAFT_MODEL=

# Admin console (Auth.js with GitHub sign-in)
# Random string used to sign sessions. Generate with: openssl rand -base64 32
AUTH_SECRET=
# GitHub OAuth app credentials for admin sign-in.
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# Comma-separated GitHub logins allowed into /admin.
ADMIN_GITHUB_LOGINS=
# Token that lets the Roadmap page create GitHub issues (repo issues write access). Optional.
GITHUB_TOKEN=

# Search engine indexing. The site blocks crawlers until launch: robots.txt disallows everything
# and every page carries <meta name="robots" content="noindex">. Set to exactly "true" to open the site.
STP_ALLOW_INDEXING=
