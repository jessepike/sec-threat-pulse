{
  "name": "sec-threat-pulse",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/db-migrate.mjs && next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "typecheck": "next typegen && tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/db-migrate.mjs --force",
    "ingest:seed": "tsx scripts/seed-sources.ts",
    "ingest:local": "tsx scripts/ingest-local.ts",
    "backtest": "tsx scripts/backtest/run.ts",
    "backtest:dataset": "tsx scripts/backtest/build-dataset.ts",
    "smoke": "node scripts/smoke.mjs",
    "agent-tests": "node scripts/agent-tests.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.3.1",
    "@neondatabase/serverless": "^1.2.0",
    "drizzle-orm": "^0.45.4",
    "fast-xml-parser": "^5.11.2",
    "mcp-handler": "2.3.0",
    "next": "16.4.3",
    "next-auth": "^5.0.0-beta.32",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
